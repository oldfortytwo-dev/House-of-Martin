rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApprovedMember() {
      return signedIn() && me().status == 'approved' && me().role in ['member', 'admin'];
    }

    function isAdmin() {
      return signedIn() && me().status == 'approved' && me().role == 'admin';
    }

    function isFriendInvitedTo(channelOrEventId, kind) {
      return signedIn() && me().status == 'approved' && me().role == 'friend' &&
        exists(/databases/$(database)/documents/$(kind)/$(channelOrEventId)) &&
        request.auth.uid in get(/databases/$(database)/documents/$(kind)/$(channelOrEventId)).data.invitedUserIds;
    }

    // Family/household/branch channels are readable by any approved member (accepted
    // simplification — see CLAUDE.md). DM channels are NOT — only the two participants.
    function canAccessChannelDoc(channelData) {
      return channelData.get('type', '') != 'dm' || request.auth.uid in channelData.get('participantIds', []);
    }
    function canAccessChannel(channelId) {
      // The parent channel doc may not exist yet (a channel is only written on first
      // message send, but its messages subcollection can be *queried* the moment a
      // viewer opens the tab) — treat a not-yet-created channel as accessible, since
      // there are no messages to protect until it exists.
      return !exists(/databases/$(database)/documents/channels/$(channelId)) ||
        canAccessChannelDoc(get(/databases/$(database)/documents/channels/$(channelId)).data);
    }

    // Users can read their own doc and (once approved) the roster; only admins edit roles/status.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isApprovedMember());
      allow create: if signedIn() && request.auth.uid == userId; // self-provision on invite redemption
      allow update: if signedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /households/{householdId} {
      allow read: if isApprovedMember();
      allow write: if isAdmin() || (isApprovedMember() && request.auth.uid == resource.data.responderId);
      // Self-service join/leave: any approved member can add or remove ONLY themselves
      // in/out of memberIds — nothing else about the household, and nobody else's
      // membership, can change via this path. Removing the caller's own uid from both
      // the old and new lists must leave them identical, or the write is denied.
      allow update: if isApprovedMember() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
        resource.data.memberIds.toSet().difference([request.auth.uid].toSet()) ==
          request.resource.data.memberIds.toSet().difference([request.auth.uid].toSet());
    }

    match /branches/{branchId} {
      allow read: if isApprovedMember();
      // Rewritten 2026-08-23: this used to try a self-service update rule keyed off
      // me().householdId (the pre-multi-household singular field), which was already broken for
      // anyone who joined a household after that migration. The replacement attempt (deriving
      // "the one household id that changed" via Set operations) turned out to be unbuildable in
      // Firestore's rules language — Set has no .toList()/indexing, so there is no way to pull a
      // single element back out of a diffed Set to run a get() lookup against it, and there's no
      // loop construct to check "for every changed id" either. Moved server-side instead: the
      // updateBranchMembership Cloud Function (functions/index.js) does the same
      // responder-or-admin check with ordinary JS and writes via the Admin SDK, which bypasses
      // these rules entirely — same pattern already used for updateHouseholdMembership. Direct
      // client writes to a branch doc stay admin-only.
      allow write: if isAdmin();
    }

    match /contacts/{contactId} {
      // A no-account family member (e.g. a young kid, or a relative who's never signed up) —
      // promoted 2026-08-23 from a household-embedded array field to its own top-level
      // document specifically so a contact can belong to more than one household at once, the
      // same ability real accounts already have via users/{uid}.householdIds. See
      // "Multi-household membership for no-account contacts" in CLAUDE.md for the full
      // rationale and the migration this required.
      //
      // Deliberately "any approved member can manage any contact," not scoped to a specific
      // household's responder — unlike a household or a branch, a contact has no single
      // "owning" household once it can belong to several, so there's no clean single field to
      // check permission against without an expensive multi-household lookup. Matches this
      // app's existing low-security/high-convenience posture for a private, trusted family app
      // (see storage.rules' albums/ comment for the same tradeoff made elsewhere).
      allow read: if isApprovedMember();
      allow create, update, delete: if isApprovedMember();
    }

    match /notifications/{notifId} {
      // Someone else's reaction/comment on your post. The actor (fromUserId) creates it — never
      // themselves as the recipient (no self-notify) — and can also delete it later (needed so
      // removing a reaction can delete the notification it generated); the recipient (forUserId)
      // can read, mark it read, or delete it, but can't create one for themselves.
      allow read, update: if signedIn() && resource.data.forUserId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.forUserId == request.auth.uid || resource.data.fromUserId == request.auth.uid);
      allow create: if isApprovedMember() && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.forUserId != request.auth.uid;
    }

    match /digestSubmissions/{submissionId} {
      // Any approved member can post something to go in the weekly digest email.
      // The digest Cloud Function (Admin SDK) marks items included after sending —
      // that write bypasses these rules entirely, no special allowance needed here.
      allow read: if isApprovedMember();
      allow create: if isApprovedMember() && request.resource.data.submittedBy == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.submittedBy == request.auth.uid);
    }

    match /occasions/{occasionId} {
      allow read: if isApprovedMember();
      allow write: if isAdmin();
    }

    match /config/{docId} {
      // App-wide config docs (currently just 'appearance' — theme default + banner photo +
      // custom themes). Any approved member reads it (needed to render the family's theme);
      // only admins write it.
      allow read: if isApprovedMember();
      allow write: if isAdmin();
    }

    match /inviteCodes/{codeId} {
      // get (fetch by known code) must be public — signup validates the code
      // *before* the account exists, so request.auth is still null at that point.
      // list stays admin-only so codes can't be enumerated.
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /channels/{channelId} {
      // resource is null when checking a not-yet-created channel (ensureChannelDoc's
      // existence probe) — nothing to protect yet, so allow the read through.
      allow read: if (isApprovedMember() && (resource == null || canAccessChannelDoc(resource.data))) || isFriendInvitedTo(channelId, 'channels');
      allow create: if isApprovedMember() && canAccessChannelDoc(request.resource.data);
      allow update, delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if (isApprovedMember() && canAccessChannel(channelId)) || isFriendInvitedTo(channelId, 'channels');
        allow create: if ((isApprovedMember() && canAccessChannel(channelId)) || isFriendInvitedTo(channelId, 'channels'))
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    match /events/{eventId} {
      allow read: if isApprovedMember() || isFriendInvitedTo(eventId, 'events');
      allow create: if isApprovedMember();
      allow update: if isApprovedMember() && (resource.data.hostId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isApprovedMember() && resource.data.hostId == request.auth.uid);

      match /rsvps/{rsvpId} {
        allow read: if isApprovedMember() || isFriendInvitedTo(eventId, 'events');
        // Chaos-tested 2026-08-29 and found broken: this used to only check
        // request.resource.data.submittedBy == request.auth.uid, which never actually
        // constrained WHICH rsvpId could be written — any approved member could silently
        // overwrite any OTHER person's individual RSVP on any event, as long as they set
        // submittedBy to their own uid. The doc id (rsvpId) is a person's uid, and the only two
        // legitimate writers of it are: that person themselves (self-RSVP), or the responder of
        // a household rsvpId actually belongs to, submitting on that household's behalf
        // (rsvpHousehold() in app/index.html). Both are now checked explicitly.
        allow write: if (isApprovedMember() || isFriendInvitedTo(eventId, 'events'))
          && request.resource.data.submittedBy == request.auth.uid
          && (
            rsvpId == request.auth.uid ||
            (
              request.resource.data.viaHousehold == true &&
              request.resource.data.householdId is string &&
              get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.responderId == request.auth.uid &&
              rsvpId in get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.memberIds
            )
          );
      }

      // Potluck-style sign-up items: anyone can suggest an item (claimed or not),
      // anyone can claim an unclaimed one or release their own claim, admins can
      // manage anything, and only the person who added/claimed an item (or an admin)
      // can delete it.
      match /signups/{signupId} {
        allow read: if isApprovedMember() || isFriendInvitedTo(eventId, 'events');
        allow create: if (isApprovedMember() || isFriendInvitedTo(eventId, 'events'))
          && request.resource.data.addedBy == request.auth.uid
          && (request.resource.data.claimedBy == null || request.resource.data.claimedBy == request.auth.uid);
        allow update: if isAdmin() || (
          (isApprovedMember() || isFriendInvitedTo(eventId, 'events')) && (
            (resource.data.claimedBy == null && request.resource.data.claimedBy == request.auth.uid) ||
            resource.data.claimedBy == request.auth.uid
          )
        );
        allow delete: if isAdmin() || (signedIn() && (resource.data.addedBy == request.auth.uid || resource.data.claimedBy == request.auth.uid));
      }
    }

    match /albums/{albumId} {
      allow read: if isApprovedMember() || isFriendInvitedTo(albumId, 'albums');
      allow create: if isApprovedMember();
      allow update, delete: if isAdmin() || (isApprovedMember() && resource.data.createdBy == request.auth.uid);

      match /photos/{photoId} {
        allow read: if isApprovedMember() || isFriendInvitedTo(albumId, 'albums');
        allow create: if (isApprovedMember() || isFriendInvitedTo(albumId, 'albums'))
          && request.resource.data.uploaderId == request.auth.uid;
        allow update, delete: if signedIn() && (resource.data.uploaderId == request.auth.uid || isAdmin());
      }
    }

    match /posts/{postId} {
      // Family Wall — a direct text+photo post, no album required. Has the same audience
      // picker as events (everyone/household/branch/individual) for *addressing* ("posted to
      // the Smiths"), not access control — every approved member can still read every post
      // regardless of audience, same deliberate simplification as events (see that match
      // block's comment for why: Firestore list-query rules can't safely per-document-filter
      // a broad collection query without reworking every query to be provably scoped).
      allow read: if isApprovedMember();
      allow create: if isApprovedMember() && request.resource.data.authorId == request.auth.uid;
      // Any approved member can update ONLY the reactions field (Like/Love/Haha/Wow/Sad/Angry)
      // on someone else's post, and only their OWN key within that map — the inner
      // .diff().affectedKeys() check (same self-toggle pattern as households/branches below)
      // stops a reaction update from being used to add/remove/overwrite anyone else's
      // reaction. Everything else (edit text, delete) stays author/admin-only.
      allow update: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid) ||
        (isApprovedMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
          request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isApprovedMember();
        allow create: if isApprovedMember() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    match /recipes/{recipeId} {
      // Family recipe box — same author/admin-only shape as posts, but WITH an update rule
      // (unlike storyAnswers): a recipe is meant to be refined over time (fixing a typo, adding a
      // missed ingredient), not a one-time capture like a story answer.
      allow read: if isApprovedMember();
      allow create: if isApprovedMember() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /storyAnswers/{answerId} {
      // Weekly story-prompt answers (text and/or a recorded voice clip) — same
      // author/admin-only write shape as posts/comments above. No update rule: an answer is
      // meant to be a one-time capture, not something silently edited after the fact — someone
      // who wants to change their answer deletes it and submits a new one.
      allow read: if isApprovedMember();
      allow create: if isApprovedMember() && request.resource.data.authorId == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }
  }
}
