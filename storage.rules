rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /albums/{albumId}/{fileName} {
      // Cross-service firestore.get()/firestore.exists() role checks were tested here
      // and proved unreliable — uploads failed with storage/unauthorized even for an
      // approved admin account, for reasons that didn't reproduce with a plain
      // request.auth != null check. Rather than depend on a flaky cross-product
      // feature, access here is intentionally just "signed in."
      //
      // This is still a reasonable trust boundary: album/photo *metadata* (and
      // therefore visibility in the app) stays fully gated by firestore.rules — only
      // approved members or explicitly-invited friends can read an album doc at all,
      // so an unapproved or uninvited account never learns the random Firestore-ID
      // album/photo path needed to hit this Storage location directly.
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // Admin override for delete isn't enforceable here without the same unreliable
      // cross-service check, so it's uploader-only at the Storage layer. An admin
      // deleting someone else's photo from the app still removes the Firestore doc
      // (that permission comes from firestore.rules, no cross-service call involved);
      // only the now-orphaned raw file would linger in Storage, which the app's
      // delete handler already tolerates (wrapped in try/catch, logs and moves on).
      allow delete: if request.auth != null && resource.metadata.uploaderId == request.auth.uid;
    }

    match /posts/{fileName} {
      // Wall post photos. Same "signed in" trust boundary as albums/ above.
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && resource.metadata.uploaderId == request.auth.uid;
    }

    match /appearance/{fileName} {
      // Header banner photo. Same "signed in" trust boundary as albums/ above (see that
      // comment for why — cross-service admin checks proved unreliable here). The app UI
      // only shows the upload control to admins, and the actual bannerUrl that gets
      // *displayed* is gated by firestore.rules' config/appearance write (admin-only) — a
      // non-admin could in theory upload a stray file to this path, but it would never be
      // referenced anywhere.
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && resource.metadata.uploaderId == request.auth.uid;
    }
  }
}
